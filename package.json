{
  "name": "kiai-web",
  "private": true,
  "version": "2.1.2",
  "description": "Kiai — stretching & mobility for martial artists. Web/PWA version of the native iOS app.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sync-content": "node scripts/sync-content.mjs",
    "ship": "node scripts/ship.mjs",
    "deploy": "npx netlify-cli deploy --prod",
    "deploy:preview": "npx netlify-cli deploy"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "netlify-cli": "^27.8.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}

